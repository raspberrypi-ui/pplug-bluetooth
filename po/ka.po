#: src/bluetooth.c:1306
#, c-format
msgid "Pairing request sent to '%s' - waiting for response..."
msgstr "დაწყვილების მოთხოვნა გაგზავნილია '%s'-ზე - პასუხის მოლოდინი..."

#: src/bluetooth.c:1315
#, c-format
msgid "Pairing failed - %s"
msgstr "დაწყვილება ჩავარდა - %s"

#: src/bluetooth.c:1323
#, c-format
msgid "Pairing successful - connecting..."
msgstr "დაწყვილება წარმატებულია - დაკავშირება..."

#: src/bluetooth.c:1331
#, c-format
msgid "Connection successful"
msgstr "კავშირი წარმატებულია"

#: src/bluetooth.c:1339 src/bluetooth.c:1602
#, c-format
msgid "Connection failed - %s"
msgstr "კავშირი ჩავარდა - %s"

#: src/bluetooth.c:1347
#, c-format
msgid "Please enter code '%s' on '%s'"
msgstr "შეიყვანეთ კოდი '%s' მოწყობილობაზე '%s'"

#: src/bluetooth.c:1355
#, c-format
msgid "Please confirm that '%s' is showing the code '%s' to pair"
msgstr "დაადასტურეთ, რომ '%s' აჩვენებს კოდს '%s' დასაწყვილებლად"

#: src/bluetooth.c:1363
#, c-format
msgid "Please enter PIN code shown on '%s'"
msgstr "შეიყვანეთ '%s'-ზე ნაჩვენები PIN-კოდი"

#: src/bluetooth.c:1371
#, c-format
msgid "Please enter passcode shown on '%s'"
msgstr "შეიყვანეთ '%s'-ზე ნაჩვენები პაროლი"

#: src/bluetooth.c:1379
#, c-format
msgid "Waiting for response from Bluetooth device..."
msgstr "ბლუთუზის მოწყობილობიდან პასუხის მოლოდინი...."

#: src/bluetooth.c:1387
#, c-format
msgid "'%s' has requested a pairing. Do you accept the request?"
msgstr "'%s'-მა დაწყვილება მოითხოვა. ეთანხმებით ამ მოთხოვნას?"

#: src/bluetooth.c:1395
#, c-format
msgid ""
"Pairing successful - right-click the volume icon to select as audio device"
msgstr ""
"დაწყვილება წარმატებულია - მარჯვენა წკაპი ხმის ხატულაზე მის "
"აუდიომოწყობილობად ასარჩევად"

#: src/bluetooth.c:1403
#, c-format
msgid ""
"Pairing successful - this device has no services which can be used with "
"Raspberry Pi"
msgstr ""
"დაწყვილება წარმატებულია - ამ მოწყობილობას სერვისი, რომლიც გამოყენებაც "
"Raspberry Pi-ზე შეიძლება, არ გააჩნია"

#: src/bluetooth.c:1582
#, c-format
msgid "Removing..."
msgstr "მიმდინარეობს წაშლა…"

#: src/bluetooth.c:1586
#, c-format
msgid "Do you want to unpair '%s'?"
msgstr "გნებავთ '%s'-სთან დაწყვილების გაუქმება?"

#: src/bluetooth.c:1589
#, c-format
msgid "Removing pairing with '%s'..."
msgstr "'%s'-სთან დაწყვილების მოცილება..."

#: src/bluetooth.c:1592
#, c-format
msgid "Removal failed - %s"
msgstr "წაშლა ჩავარდა - %s"

#: src/bluetooth.c:1601
#, c-format
msgid "Connecting..."
msgstr "დაკავშირება..."

#: src/bluetooth.c:1602
#, c-format
msgid "Connecting to '%s'..."
msgstr "'%s'-სთან დაკავშირება..."

#: src/bluetooth.c:1606
#, c-format
msgid "Disconnecting..."
msgstr "კავშირის გაწყვეტა..."

#: src/bluetooth.c:1607
#, c-format
msgid "Disconnecting from '%s'..."
msgstr "'%s'-დან გათიშვა..."

#: src/bluetooth.c:1607
#, c-format
msgid "Disconnection failed - %s"
msgstr "გათიშვა ჩავარდა - %s"

#: src/bluetooth.c:1722
msgid "No usable services on this device"
msgstr "ამ მოწყობილობაზე გამოყენებადი სერვისები აღმოჩენილი არაა"

#: src/bluetooth.c:1787
msgid "Disconnect..."
msgstr "გათიშვა..."

#: src/bluetooth.c:1792
msgid "Connect..."
msgstr "დაკავშირება..."

#. add the remove option to the submenu
#: src/bluetooth.c:1805
msgid "Remove..."
msgstr "წაშლა..."

#. warn if no BT hardware detected
#: src/bluetooth.c:2001
msgid "No Bluetooth adapter found"
msgstr "ბლუთუზის ადაპტერი აღმოჩენილი არაა"

#. add enable bt option
#: src/bluetooth.c:2008
msgid "Turn On Bluetooth"
msgstr "ბლუთუზის ჩართვა"

#. add disable bt option
#: src/bluetooth.c:2018
msgid "Turn Off Bluetooth"
msgstr "ბლუთუზის გამორთვა"

#: src/bluetooth.c:2028
msgid "Stop Discoverable"
msgstr "აღმოჩენადობის გაჩერება"

#: src/bluetooth.c:2030
msgid "Make Discoverable"
msgstr "აღმოჩენადი"

#. add and remove dialogs
#: src/bluetooth.c:2038
msgid "Add Device..."
msgstr "მოწყობილობის დამატება..."

#: src/bluetooth.c:2159
msgid "Manage Bluetooth devices"
msgstr "ბლუთუზის მოწყობილობის მართვა"

#: src/bluetooth.c:2266
msgid "Manages Bluetooth devices"
msgstr "ბლუთუზის მოწყობილობის მართვა"

