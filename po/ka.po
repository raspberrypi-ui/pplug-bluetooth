msgstr "ბლუთუზის მოწყობილობების ძებნა..."

#: data/lxplug-bluetooth.ui:128
msgid "label"
msgstr "ჭდე"

#: data/lxplug-bluetooth.ui:170
msgid "_OK"
msgstr "_დიახ"

#: data/lxplug-bluetooth.ui:194
