#: data/lxplug-bluetooth.ui:23 data/lxplug-bluetooth.ui:155
msgid "_Cancel"
msgstr "გაუ_ქმება"

#: data/lxplug-bluetooth.ui:37
msgid "_Pair"
msgstr "_დაწყვილება"

#: data/lxplug-bluetooth.ui:60
